# ========================================================
# Merit & Beyond - Consultation Email Configuration
# ========================================================

# The recipient email where consultation leads will be delivered
NOTIFICATION_RECIPIENT_EMAIL=hellostartlet.hr@gmail.com

# SMTP Server Details (Default: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Your Gmail or Email account used to send the emails:
SMTP_USER=hellostartlet.hr@gmail.com

# Gmail 16-character App Password (NOT your regular Gmail login password):
# How to get it in 60 seconds:
# 1. Open https://myaccount.google.com/security
# 2. Ensure 2-Step Verification is ON
# 3. Search for "App Passwords" (or go to https://myaccount.google.com/apppasswords)
# 4. Create an app named "Merit & Beyond Website"
# 5. Paste the generated 16-character code below (no spaces):
SMTP_PASS=your-16-char-app-password
